# Ignore configuration files that may contain database passwords.
web/sites/*/settings*
!web/sites/*/default.settings.php
!web/sites/*/example.settings.local.php
web/sites/*/settings.local.php

# Ignore paths that contain user-generated content.
web/sites/*/files
!web/sites/*/files/sync

# Ignore directories generated by Composer
/vendor/
/web/core/
/web/modules/contrib/
/web/themes/contrib/
/web/profiles/contrib/
/drush/contrib/

# Ignore frontend dependencies
node_modules/
**/node_modules/

# Ignore database dumps and backups
*.sql
*.sql.gz
*.dump
/db/
cpg_project_backup.sql.gz

# Ignore logs
*.log
error_log
web/error_log

# Ignore .env files
.env
.env.*
.env.local

# Operating System and IDE files
.DS_Store
Thumbs.db
.idea/
.vscode/
