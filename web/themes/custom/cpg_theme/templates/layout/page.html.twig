{#
/**
 * @file
 * Theme override to display a single page for CPG Matters.
 */
#}
<div class="cpg-layout">

  {# ===== HEADER ===== #}
  {% if page.header or page.header_search or page.primary_menu %}
    <header class="cpg-layout__header" role="banner">
      <div class="cpg-container header-inner">
        
        {# Branding #}
        <div class="header-branding">
          <a href="/" class="site-branding-link">
            {% if site_logo %}
              <img src="{{ site_logo }}" alt="{{ site_name }}" class="site-logo-img" style="max-height: 40px; width: auto; display: block; margin-bottom: 4px;" />
            {% else %}
              <h1 class="site-title">{{ site_name|default('CPG Matters') }}</h1>
            {% endif %}
            {% if site_slogan %}
            <div class="site-slogan">{{ site_slogan }}</div>
          {% endif %}
          </a>
        </div>

        {# Navigation #}
        <div class="header-nav">
          {{ page.primary_menu }}
        </div>

        {# Actions (Subscribe + Search + Mobile Hamburger) #}
        <div class="header-actions">
          {# Mobile-only hamburger for main nav #}
          <button class="mobile-nav-hamburger" aria-label="Open navigation" aria-expanded="false">
            <span class="mobile-nav-hamburger__bar"></span>
            <span class="mobile-nav-hamburger__bar"></span>
            <span class="mobile-nav-hamburger__bar"></span>
          </button>
          {% if page.header_actions %}
            {{ page.header_actions }}
          {% endif %}
        </div>

      </div>
    </header>

    {# ===== FLOATING TOPIC ICON SIDEBAR (Dynamically rendered from block) ===== #}
    {% if page.mobile_topics %}
      {{ page.mobile_topics }}
    {% endif %}

    {# ===== MOBILE NAV DRAWER (separate from topics flyout) ===== #}
    <div class="mobile-nav-overlay"></div>
    <nav class="mobile-nav-drawer" aria-label="Mobile navigation">
      <div class="mobile-nav-drawer__header">
        <span class="mobile-nav-drawer__title">{{ 'Navigation'|t }}</span>
        <button class="mobile-nav-drawer__close" aria-label="Close navigation">&times;</button>
      </div>

      {% if page.mobile_nav %}
        {{ page.primary_menu }}
      {% endif %}
    </nav>
  {% endif %}

  {% if page.hero %}
    <section class="cpg-layout__hero cpg-container">
      {{ page.hero }}
    </section>
  {% endif %}

  {% if page.top_banner %}
    <div class="cpg-layout__ad cpg-container">
      {{ page.top_banner }}
    </div>
  {% endif %}

  <main role="main" class="cpg-layout__main cpg-container">


    {% set layout_class = 'cpg-columns' %}
    {% if page.sidebar_first and page.sidebar_second %}
      {% set layout_class = layout_class ~ ' has-both-sidebars' %}
    {% elseif page.sidebar_first %}
      {% set layout_class = layout_class ~ ' has-sidebar-first' %}
    {% elseif page.sidebar_second %}
      {% set layout_class = layout_class ~ ' has-sidebar-second' %}
    {% else %}
      {% set layout_class = layout_class ~ ' no-sidebars' %}
    {% endif %}

    <div class="{{ layout_class }}">
      {% if page.sidebar_first %}
        <aside class="cpg-sidebar cpg-sidebar--first" role="complementary">
          {{ page.sidebar_first }}
        </aside>
      {% endif %}

      <div class="cpg-content-main">
        {% if page.breadcrumb %}
          {{ page.breadcrumb }}
        {% endif %}
        {{ page.content }}
      </div>

      {% if page.sidebar_second %}
        <aside class="cpg-sidebar cpg-sidebar--second" role="complementary">
          {{ page.sidebar_second }}
        </aside>
      {% endif %}
    </div>
  </main>

  <footer class="cpg-layout__footer" role="contentinfo">
    <div class="cpg-container footer-columns">
      <div class="footer-col">{{ page.footer_first }}</div>
      <div class="footer-col">{{ page.footer_second }}</div>
      <div class="footer-col">{{ page.footer_third }}</div>
      <div class="footer-col">
        {{ page.footer_fourth }}
        
        {# Dynamic Social Media Links from Theme Settings #}
        {% if cpg_twitter_url or cpg_facebook_url or cpg_linkedin_url %}
          <div class="cpg-social-links" style="display: flex; gap: 15px; margin-top: 1.5rem;">
            {% if cpg_twitter_url %}
              <a href="{{ cpg_twitter_url }}" target="_blank" rel="noopener" aria-label="X (Twitter)" style="display: flex; align-items: center; justify-content: center; width: 36px; height: 36px; border-radius: 50%; background: rgba(255,255,255,0.1); color: #fff; text-decoration: none; font-weight: bold; font-family: sans-serif; transition: background 0.3s;" onmouseover="this.style.background='#C41E3A'" onmouseout="this.style.background='rgba(255,255,255,0.1)'">X</a>
            {% endif %}
            {% if cpg_facebook_url %}
              <a href="{{ cpg_facebook_url }}" target="_blank" rel="noopener" aria-label="Facebook" style="display: flex; align-items: center; justify-content: center; width: 36px; height: 36px; border-radius: 50%; background: rgba(255,255,255,0.1); color: #fff; text-decoration: none; font-weight: bold; font-family: serif; transition: background 0.3s;" onmouseover="this.style.background='#C41E3A'" onmouseout="this.style.background='rgba(255,255,255,0.1)'">f</a>
            {% endif %}
            {% if cpg_linkedin_url %}
              <a href="{{ cpg_linkedin_url }}" target="_blank" rel="noopener" aria-label="LinkedIn" style="display: flex; align-items: center; justify-content: center; width: 36px; height: 36px; border-radius: 50%; background: rgba(255,255,255,0.1); color: #fff; text-decoration: none; font-weight: bold; font-family: serif; transition: background 0.3s;" onmouseover="this.style.background='#C41E3A'" onmouseout="this.style.background='rgba(255,255,255,0.1)'">in</a>
            {% endif %}
          </div>
        {% endif %}
      </div>
    </div>
    
    {% if page.footer_bottom %}
      <div class="footer-bottom">
        <div class="cpg-container">
          {{ page.footer_bottom }}
        </div>
      </div>
    {% endif %}
  </footer>
</div>

